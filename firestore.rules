rules_version = '2';

// Security model for Site-19: Tau-5 Protocol (Firebase Spark plan, no Cloud Functions).
// Because there's no trusted server, the lobby host's client acts as the resolver for
// role assignment and night-action resolution (see docs/adr/ and CONTEXT.md). These rules
// enforce the hidden-information boundary as far as Firestore rules can:
//   - secretRoles / nightResults: readable only by the player themself or the current host.
//   - nightActions: readable ONLY by the host — this is where hidden info actually lives.
//   - Known, accepted limitation: ghost tip anonymity (authorUid) is not hidden from a
//     technically capable reader of raw Firestore; and the host has broad read access to
//     secretRoles by design. Both are accepted trade-offs for a friends-only game.

service cloud.firestore {
  match /databases/{database}/documents {
    match /lobbies/{lobbyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.hostUid == request.auth.uid ||
        // host takeover: only allowed when writing hostUid itself, guarded by staleness client-side
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostUid', 'hostLastSeen'])
      );

      match /players/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth.uid == uid;
        allow update: if request.auth.uid == uid ||
          get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
        // Leaving before the game starts removes the player doc entirely; once in_progress,
        // leaving is a forfeit handled via update (alive: false), not a delete.
        allow delete: if request.auth.uid == uid &&
          get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.status == 'lobby';
      }

      match /secretRoles/{uid} {
        // Also readable teammate-to-teammate within Chaos Insurgency: "the CI team chooses a
        // kill together" (CONTEXT.md) already implied they know each other, and Anomaly
        // specifically needs to know who not to target. A query naturally excludes denied
        // docs rather than failing outright, since this is a per-document content check.
        allow read: if request.auth.uid == uid ||
          get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid ||
          (get(/databases/$(database)/documents/lobbies/$(lobbyId)/secretRoles/$(request.auth.uid)).data.faction == 'ci' &&
           resource.data.faction == 'ci');
        allow write: if get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
      }

      match /nightActions/{actionId} {
        allow create: if request.auth.uid == request.resource.data.actorUid;
        allow read: if get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
        // Host-only: clearing prior-game data on restart.
        allow delete: if get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
      }

      match /nightResults/{resultId} {
        allow read: if request.auth.uid == resource.data.recipientUid ||
          get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
        allow write: if get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
      }

      match /votes/{voteId} {
        allow create: if request.auth.uid == request.resource.data.voterUid;
        allow read: if request.auth != null;
        // Host-only: clearing prior-game data on restart.
        allow delete: if get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
      }

      match /publicCycleLog/{cycleId} {
        allow read: if request.auth != null;
        allow write: if get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
      }

      match /ghostTips/{tipId} {
        allow create: if request.auth.uid == request.resource.data.authorUid &&
          get(/databases/$(database)/documents/lobbies/$(lobbyId)/players/$(request.auth.uid)).data.alive == false;
        allow read: if request.auth != null;
        // Host-only: clearing prior-game data on restart.
        allow delete: if get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
      }

      match /wills/{uid} {
        // Locked at the moment of death: writable only by the author, and only while alive -
        // this is what makes a "revealed will" actually a frozen last-words snapshot rather
        // than something editable after everyone's already seen it.
        allow write: if request.auth.uid == uid &&
          get(/databases/$(database)/documents/lobbies/$(lobbyId)/players/$(uid)).data.alive == true;
        allow read: if request.auth.uid == uid ||
          get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid ||
          get(/databases/$(database)/documents/lobbies/$(lobbyId)/players/$(uid)).data.alive == false;
        // Host-only: clearing prior-game data on restart.
        allow delete: if get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
      }

      match /puppeteerOverrides/{uid} {
        // Doc id == the Puppeteer's own uid (one override total per game). Host-only read -
        // the whole point is the target never finds out, so nobody but the resolver sees this.
        allow create: if request.auth.uid == uid;
        allow read, delete: if get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
      }

      match /tomeTransfers/{uid} {
        // Doc id == the requesting holder's own uid. The resolver defensively re-checks that
        // this uid actually IS the current holder before applying it, so the rule itself only
        // needs to confirm self-authorship, not holder status.
        allow create: if request.auth.uid == uid;
        allow read, delete: if get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.hostUid == request.auth.uid;
      }
    }
  }
}
